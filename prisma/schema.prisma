// ============================================================
// FamiCash v2 - Modelo de datos
// Taxonomía de 3 niveles: Categoría → Subcategoría → Detalle
// Moneda S/ · Zona horaria America/Lima (fechas guardadas como DATE)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoMovimiento {
  INGRESO
  GASTO
  AHORRO
}

enum Persona {
  FAMILIA
  ANTHONY
  VANESSA
  LARA
}

enum PeriodoTipo {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  persona      Persona   @default(FAMILIA)
  refreshToken String?   @map("refresh_token") @db.Text
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  favoritos     Favorito[]
  transacciones Transaccion[]

  @@map("usuarios")
}

model Categoria {
  id        Int            @id @default(autoincrement())
  codigo    String         @unique @db.VarChar(60) // Ej: II_GENERALES
  tipo      TipoMovimiento
  persona   Persona        @default(FAMILIA)
  orden     Int            @default(0)
  activa    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  subcategorias Subcategoria[]
  transacciones Transaccion[]
  presupuestos  Presupuesto[]

  @@index([orden])
  @@map("categorias")
}

model Subcategoria {
  id          Int       @id @default(autoincrement())
  categoriaId Int       @map("categoria_id")
  codigo      String    @db.VarChar(80) // Ej: _6_ALIMENTACION
  persona     Persona?  // Sobrescribe la persona de la categoría (p.ej. _1_AHORRO_VANESSA)
  orden       Int       @default(0)
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  categoria     Categoria        @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  detalles      Detalle[]
  transacciones Transaccion[]
  favoritos     Favorito[]
  presupuestos  Presupuesto[]
  objetivos     ObjetivoAhorro[]

  @@unique([categoriaId, codigo])
  @@index([categoriaId, orden])
  @@map("subcategorias")
}

model Detalle {
  id             Int       @id @default(autoincrement())
  subcategoriaId Int       @map("subcategoria_id")
  nombre         String    @db.VarChar(200)
  orden          Int       @default(0)
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  subcategoria  Subcategoria  @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  transacciones Transaccion[]

  @@index([subcategoriaId, orden])
  @@map("detalles")
}

model MedioPago {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique @db.VarChar(120)
  persona   Persona   @default(FAMILIA)
  orden     Int       @default(0)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  transacciones Transaccion[]

  @@map("medios_pago")
}

model Transaccion {
  id             Int            @id @default(autoincrement())
  fecha          DateTime       @db.Date
  tipo           TipoMovimiento
  categoriaId    Int            @map("categoria_id")
  subcategoriaId Int            @map("subcategoria_id")
  detalleId      Int?           @map("detalle_id")
  medioPagoId    Int?           @map("medio_pago_id")
  monto          Decimal        @db.Decimal(12, 2)
  persona        Persona        @default(FAMILIA)
  clase          String?        @db.VarChar(20) // Cotidiano | Fijo | Extra (opcional)
  observaciones  String?        @db.VarChar(500)

  // Snapshot histórico de nombres: renombrar la taxonomía no rompe reportes ni exportaciones
  categoriaNombre    String  @map("categoria_nombre") @db.VarChar(60)
  subcategoriaNombre String  @map("subcategoria_nombre") @db.VarChar(80)
  detalleNombre      String? @map("detalle_nombre") @db.VarChar(200)
  medioPagoNombre    String? @map("medio_pago_nombre") @db.VarChar(120)

  creadoPorId Int?     @map("creado_por")
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  categoria    Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  subcategoria Subcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  detalle      Detalle?     @relation(fields: [detalleId], references: [id], onDelete: SetNull)
  medioPago    MedioPago?   @relation(fields: [medioPagoId], references: [id], onDelete: SetNull)
  creadoPor    Usuario?     @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([tipo, fecha])
  @@index([categoriaId, fecha])
  @@index([subcategoriaId, fecha])
  @@index([persona, fecha])
  @@map("transacciones")
}

model Favorito {
  id             Int @id @default(autoincrement())
  usuarioId      Int @map("usuario_id")
  subcategoriaId Int @map("subcategoria_id")
  orden          Int @default(0)

  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  subcategoria Subcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, subcategoriaId])
  @@map("favoritos")
}

model Presupuesto {
  id             Int         @id @default(autoincrement())
  periodoTipo    PeriodoTipo @map("periodo_tipo")
  periodo        String      @db.VarChar(10) // 2026-11 | 2026-Q4 | 2026
  categoriaId    Int         @map("categoria_id")
  subcategoriaId Int?        @map("subcategoria_id")
  monto          Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  categoria    Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  subcategoria Subcategoria? @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)

  @@index([periodoTipo, periodo])
  @@map("presupuestos")
}

model ObjetivoAhorro {
  id                  Int       @id @default(autoincrement())
  nombre              String    @db.VarChar(120)
  tipo                String    @db.VarChar(60) // Fondo de emergencia, Vacaciones... (editable)
  montoMeta           Decimal   @map("monto_meta") @db.Decimal(12, 2)
  montoInicial        Decimal   @default(0) @map("monto_inicial") @db.Decimal(12, 2)
  fechaObjetivo       DateTime? @map("fecha_objetivo") @db.Date
  responsable         Persona   @default(FAMILIA)
  subcategoriaAhorroId Int?     @map("subcategoria_ahorro_id")
  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  subcategoriaAhorro Subcategoria? @relation(fields: [subcategoriaAhorroId], references: [id], onDelete: SetNull)

  @@map("objetivos_ahorro")
}
