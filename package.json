{
  "name": "famicash-backend",
  "version": "1.0.0",
  "description": "API REST Backend para FamiCash con PostgreSQL",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed.js --demo",
    "db:deploy": "prisma db push --skip-generate && node prisma/seed.js",
    "db:check": "node src/lib/prisma/check-db.js"
  },
  "keywords": [
    "finance",
    "famicash",
    "postgres",
    "express",
    "crud"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "prisma": "^6.19.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
